#!/usr/bin/env bash
# A szkript EGYETLEN elvarasa a routertol: kapjon egy RouterOS-parancsot
# elso argumentumkent, es irja a kimenetet a stdout-ra.
#
#   ./mikrotik-ssh.sh '/system/resource/print'
#
# Sajat kulcsos, CSAK OLVASO fiokkal ajanlott (RouterOS: group=read).
set -euo pipefail
ROUTER_HOST="${ROUTER_HOST:-192.0.2.1}"
ROUTER_USER="${ROUTER_USER:-watchdog-ro}"
ROUTER_KEY="${ROUTER_KEY:-$HOME/.ssh/id_router_ro}"
exec ssh -i "$ROUTER_KEY" -o StrictHostKeyChecking=yes \
     -o ConnectTimeout=10 "${ROUTER_USER}@${ROUTER_HOST}" "$1"
